# API legacy del sandbox Localito (SQLite). No es fuente de verdad on-chain.
# Sólo la usa /legacy; PREStAR lee saldos directo de Arbitrum One.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# --- PREStAR on-chain (Arbitrum One mainnet, chain fija 42161) ---
# Dirección verificada de PrestarCore. Sin este valor el frontend muestra
# "contrato aún no desplegado" y deshabilita TODAS las llamadas on-chain.
# No inventar ni completar con una dirección de ejemplo. No hay fallback a
# transfer directo de ARGt.
NEXT_PUBLIC_PRESTAR_CORE_ADDRESS=

# RPC HTTP de Arbitrum One para leer saldos, allowance y receipts (opcional).
# Vacío = RPC público por defecto de la red. Nunca pongas claves privadas,
# mnemonics ni API keys de wallet en variables NEXT_PUBLIC_*.
NEXT_PUBLIC_PRESTAR_RPC_URL=

# Contrato ARGt (ERC-20, 18 decimales) en Arbitrum One.
# Default: 0x59863989d080B22476DB95656d0C3CC18be92214
# Sólo cambialo si el token oficial cambia y lo verificaste en Arbiscan.
NEXT_PUBLIC_ARGT_TOKEN_ADDRESS=0x59863989d080B22476DB95656d0C3CC18be92214

# Compatibilidad con el widget legacy retirado: si existe, se usa como
# fallback de RPC cuando NEXT_PUBLIC_PRESTAR_RPC_URL está vacío.
NEXT_PUBLIC_ARGT_RPC_URL=
